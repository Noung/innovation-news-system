# Innovation News canonical environment file
# Copy to .env at the workspace root. Never commit real credentials.

# Database
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASS=your_mysql_password
DB_NAME=innovation_news
DB_CONNECT_TIMEOUT_SECONDS=10

# Fetch runtime
DRY_RUN=0
ENABLE_TELEGRAM=1
ENABLE_WORDPRESS=1
ENABLE_LINE=1
INNOVATION_NEWS_ENV_SOURCE=workspace-root
INNOVATION_NEWS_WORKSPACE_DIR=
INNOVATION_NEWS_ALLOW_INACTIVE_SOURCE_URLS=0
INNOVATION_NEWS_FETCH_LOCK_NAME=innovation-news:innovation_news:fetch
INNOVATION_NEWS_FETCH_LOCK_TIMEOUT_SECONDS=0
INNOVATION_NEWS_FETCH_FILE_LOCK=/home/your-user/innovation_news/cache/innovation-news-fetch.lock
INNOVATION_NEWS_SOURCE_API_KEY_NEWSAPI=
INNOVATION_NEWS_SOURCE_API_KEY_HEADER_NEWSAPI=X-Api-Key

# Telegram / OpenClaw
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
OPENCLAW_BIN=openclaw
KSSTAT_CA_BUNDLE=

# WordPress
WP_API_URL=https://your-wordpress-site.example/wp-json
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=your_wordpress_application_password
WP_BENEFIT_TAXONOMY_REST_BASE=organization-benefits
WP_VERIFY_TLS=1
# Optional PEM bundle for a private/internal CA. Empty uses the system trust store.
WP_CA_BUNDLE=

# LINE
LINE_API_URL=https://your-line-gateway.example/api/notify
LINE_API_KEY=your_line_api_key
LINE_VERIFY_TLS=1
LINE_CA_BUNDLE=

# Admin API
PORT=3001
ADMIN_BIND_HOST=127.0.0.1
ADMIN_TRUST_PROXY=loopback
ADMIN_CORS_ORIGINS=
# Required before starting Admin API. Use a unique username, a generated
# password of at least 16 characters, and a generated secret of at least 32.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_LOGIN_RATE_WINDOW_MS=900000
ADMIN_LOGIN_RATE_MAX_ATTEMPTS=10

# Phase 0 gates: subscriptions and outbound email are intentionally disabled.
ENABLE_SUBSCRIPTION_API=0
ENABLE_EMAIL_WORKER=0
EMAIL_SEND_MODE=disabled
SUBSCRIPTION_ALLOWED_ORIGINS=
SUBSCRIPTION_CONFIRM_BASE_URL=
SUBSCRIPTION_TOKEN_SECRET=
SUBSCRIPTION_RATE_WINDOW_MS=3600000
SUBSCRIPTION_RATE_MAX_ATTEMPTS=5
SUBSCRIPTION_TOKEN_TTL_SECONDS=86400
EMAIL_WORKER_BATCH_SIZE=50
EMAIL_WORKER_MAX_ATTEMPTS=3
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USERNAME=
SMTP_PASSWORD=
