# ====================================
# Innovation News - Environment Variables
# ====================================

# ====================================
# Database Configuration
# ====================================
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASS=your_mysql_password
DB_NAME=innovation_news

# ====================================
# Telegram Integration
# ====================================
# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token
# Target Chat ID (get from Telegram API or use @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id
# OpenClaw binary path (default: 'openclaw')
OPENCLAW_BIN=openclaw
KSSTAT_CA_BUNDLE=
# Enable/disable Telegram (default: 1)
ENABLE_TELEGRAM=1

# ====================================
# WordPress Integration
# ====================================
# WordPress REST API root (e.g., https://your-site.com/wp-json)
WP_API_URL=https://your-wordpress-site.com/wp-json
# WordPress username
WP_USERNAME=your_wp_username
# WordPress Application Password (NOT regular password!)
# Generate at: /wp-admin/profile.php → Application Passwords
WP_APP_PASSWORD=your_wp_app_password
# REST base registered by the Innovation Tip Benefit Taxonomy plugin
WP_BENEFIT_TAXONOMY_REST_BASE=organization-benefits
# Verify HTTPS certificates by default. For an internal CA, set its PEM path.
WP_VERIFY_TLS=1
WP_CA_BUNDLE=
# Enable/disable WordPress (default: 1)
ENABLE_WORDPRESS=1

# ====================================
# LINE Integration
# ====================================
# LINE Notify API URL (OAR Notify endpoint)
LINE_API_URL=https://your-line-api-endpoint.com/api/notify
# LINE API Key
LINE_API_KEY=your_line_api_key
# Enable/disable LINE (default: 1)
ENABLE_LINE=1
LINE_VERIFY_TLS=1
LINE_CA_BUNDLE=

# ====================================
# Runtime Configuration
# ====================================
# Dry run mode (1 = dry run, 0 = normal)
DRY_RUN=0
# Allow fetching from inactive sources (1 = yes, 0 = no)
INNOVATION_NEWS_ALLOW_INACTIVE_SOURCE_URLS=0
# Workspace directory (default: auto-detected)
INNOVATION_NEWS_WORKSPACE_DIR=
# MySQL advisory lock shared by cron and manual runs (0 = do not wait).
INNOVATION_NEWS_FETCH_LOCK_NAME=innovation-news:innovation_news:fetch
INNOVATION_NEWS_FETCH_LOCK_TIMEOUT_SECONDS=0
INNOVATION_NEWS_FETCH_FILE_LOCK=/home/your-user/innovation_news/cache/innovation-news-fetch.lock
INNOVATION_NEWS_SOURCE_API_KEY_NEWSAPI=
INNOVATION_NEWS_SOURCE_API_KEY_HEADER_NEWSAPI=X-Api-Key

# Phase 0 safety gates. Keep disabled until the subscription phase is approved.
ENABLE_SUBSCRIPTION_API=0
ENABLE_EMAIL_WORKER=0
EMAIL_SEND_MODE=disabled
