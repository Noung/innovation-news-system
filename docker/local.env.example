# Safe, tracked local-only values. Never replace these with PROD credentials.

DB_HOST=mysql
DB_USER=innovation_local
DB_PASS=local-only-database-password
DB_NAME=innovation_news
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_SIZE=10

DRY_RUN=1
ENABLE_TELEGRAM=1
ENABLE_WORDPRESS=1
ENABLE_LINE=1
INNOVATION_NEWS_ENV_FILE=/workspace/docker/local.env.example
INNOVATION_NEWS_ENV_SOURCE=local-compose
INNOVATION_NEWS_WORKSPACE_DIR=/workspace
INNOVATION_NEWS_MAIN_SCRIPT=/workspace/scripts/fetch-innovation-news-mysql.py
INNOVATION_NEWS_FETCH_WORKDIR=/workspace/scripts
INNOVATION_NEWS_LOG_DIR=/workspace/logs
INNOVATION_NEWS_SOURCES_INDEX_FILE=/workspace/cache/innovation-sources-index.txt
INNOVATION_NEWS_ALLOW_INACTIVE_SOURCE_URLS=0
INNOVATION_NEWS_FETCH_LOCK_NAME=innovation-news:local:fetch
INNOVATION_NEWS_FETCH_LOCK_TIMEOUT_SECONDS=0
INNOVATION_NEWS_FETCH_FILE_LOCK=/workspace/cache/innovation-news-fetch.lock
PYTHON_BIN=/opt/venv/bin/python
REQUESTS_CA_BUNDLE=/certs/local-ca.crt

TELEGRAM_TOKEN=local-only-telegram-token
TELEGRAM_CHAT_ID=local-only-chat
OPENCLAW_BIN=/workspace/docker/mock/openclaw-mock

WP_API_URL=https://mock-integrations:8443/wp-json
WP_USERNAME=local-wordpress-user
WP_APP_PASSWORD=local-only-wordpress-password
WP_BENEFIT_TAXONOMY_REST_BASE=organization-benefits
WP_VERIFY_TLS=1
WP_CA_BUNDLE=/certs/local-ca.crt

LINE_API_URL=https://mock-integrations:8443/api/notify
LINE_API_KEY=local-only-line-key
LINE_VERIFY_TLS=1
LINE_CA_BUNDLE=/certs/local-ca.crt

PORT=3001
ADMIN_BIND_HOST=0.0.0.0
ADMIN_TRUST_PROXY=loopback
ADMIN_CORS_ORIGINS=
ADMIN_USERNAME=local-admin
ADMIN_PASSWORD=L0calDev-2026-Safe
ADMIN_SESSION_SECRET=local-only-session-secret-32-characters-minimum
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_LOGIN_RATE_WINDOW_MS=900000
ADMIN_LOGIN_RATE_MAX_ATTEMPTS=10

ENABLE_SUBSCRIPTION_API=0
ENABLE_EMAIL_WORKER=0
EMAIL_SEND_MODE=json
SUBSCRIPTION_ALLOWED_ORIGINS=https://wordpress.local.test
SUBSCRIPTION_CONFIRM_BASE_URL=https://wordpress.local.test/
SUBSCRIPTION_TOKEN_SECRET=local-only-subscription-token-secret-32-characters
SUBSCRIPTION_RATE_WINDOW_MS=3600000
SUBSCRIPTION_RATE_MAX_ATTEMPTS=5
SUBSCRIPTION_TOKEN_TTL_SECONDS=86400
EMAIL_WORKER_BATCH_SIZE=50
EMAIL_FROM=Innovation News <no-reply@local.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USERNAME=
SMTP_PASSWORD=
